# Configuración de Base de Datos
POSTGRES_USER=triviauser
POSTGRES_PASSWORD=TU_PASSWORD_SEGURO_AQUI
POSTGRES_DB=triviadb

# Configuración del Backend
JWT_SECRET=TU_SECRETO_JWT_SUPER_SEGURO_AQUI_CAMBIAR_EN_PRODUCCION
NODE_ENV=production
ADMIN_USERNAME=admin
ADMIN_PASSWORD=TU_PASSWORD_ADMIN_SEGURO_AQUI

# Configuración del Frontend
# Reemplaza TU_IP_PUBLICA_EC2 con la IP pública o dominio de tu EC2
# Ejemplo: http://54.123.45.67 o http://tudominio.com
VITE_API_URL=http://TU_IP_PUBLICA_EC2

